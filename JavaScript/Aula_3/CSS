body {
  font-family: Arial, sans-serif;
  background-color: #eef2f7;
  margin: 0;
}

header {
  background-color: #1f3a5f;
  color: white;
  text-align: center;
  padding: 15px;
}

main {
  width: 90%;
  max-width: 400px;
  margin: 30px auto;
  padding: 20px;
  background-color: white;
  border: 2px solid #1f3a5f;
  border-radius: 10px;
}

.campo {
  margin-bottom: 15px;
}

label {
  display: block;
  margin-bottom: 5px;
}

input {
  width: 100%;
  padding: 8px;
  box-sizing: border-box;
}

button {
  width: 100%;
  padding: 10px;
  color: white;
  background-color: #1f3a5f;
  border: none;
  border-radius: 5px;
}

#resultado {
  margin-top: 20px;
  text-align: center;
  font-weight: bold;
}

footer {
  text-align: center;
  padding: 15px;
}
