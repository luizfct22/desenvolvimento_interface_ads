Parte D — Desafio integrador
Exercício 16 — Compra com desconto

const produto = "Teclado";
const precoUnitario = 80;
const quantidade = 3;
const percentualDesconto = 10;

const subtotal = precoUnitario * quantidade;
const desconto = subtotal * percentualDesconto / 100;
const total = subtotal - desconto;

console.log("Produto:", produto);
console.log("Preço unitário: R$", precoUnitario);
console.log("Quantidade:", quantidade);
console.log("Subtotal: R$", subtotal);
console.log("Desconto: R$", desconto);
console.log("Valor final: R$", total);
